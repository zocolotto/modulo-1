programa {
  funcao inicio() {
    real numero1
    real numero2
    real resto 
    escreva ("digite o primeiro numero ")
    leia (numero1)

    escreva ("digite o segundo numero ")
    leia (numero2)
    
    resto = numero1/ numero2 

    escreva ("o resto da divisão entre ", numero1, " e ", numero2, " é: ", resto)
  }
}
